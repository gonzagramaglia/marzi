---
import { tinaField } from '@tinacms/astro/tina-field';
import { Icon } from 'astro-icon/components';

interface TestimonialItem {
	quote?: string | null;
	author?: string | null;
	role?: string | null;
}

interface Props {
	data?: {
		title?: string | null;
		description?: string | null;
		testimonials?: (TestimonialItem | null)[] | null;
	} | null;
}

const { data } = Astro.props;
const title = data?.title ?? 'Testimonios de Nuestros Pacientes';
const testimonials = (data?.testimonials ?? []).filter((t): t is TestimonialItem => Boolean(t));
---

<section class="w-full bg-[#fcfaf5] py-16 px-6 sm:px-8 md:py-24 text-[#222222] overflow-hidden">
	<div class="mx-auto max-w-5xl">
		<!-- Section Title -->
		<div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
			<h2
				class="text-3xl sm:text-4xl font-bold tracking-tight text-[#824f91]"
				data-tina-field={data ? tinaField(data, 'title') : undefined}
			>
				{title}
			</h2>
		</div>

		<!-- Testimonials Carousel Container -->
		<div id="testimonials-carousel" class="relative select-none" data-count={testimonials.length}>
			<!-- Slides Viewport -->
			<div class="overflow-hidden">
				<div
					id="carousel-track"
					class="flex transition-transform duration-500 ease-out"
				>
					{testimonials.map((item) => (
						<div
							class="w-full md:w-1/2 shrink-0 px-4 sm:px-6 flex flex-col items-center text-center"
							data-tina-field={tinaField(item)}
						>
							<!-- Quote Icon -->
							<div class="mb-4 text-[#824f91]">
								<svg
									class="size-8 sm:size-10 fill-current opacity-80"
									viewBox="0 0 24 24"
								>
									<path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
								</svg>
							</div>

							<blockquote
								class="text-base sm:text-lg font-medium text-neutral-800 leading-relaxed mb-6 max-w-md"
								data-tina-field={tinaField(item, 'quote')}
							>
								“{item.quote}”
							</blockquote>

							<div class="mt-auto">
								<p
									class="text-xs sm:text-sm text-neutral-500 font-medium"
									data-tina-field={tinaField(item, 'author')}
								>
									{item.author}{item.role ? `, ${item.role}` : ''}
								</p>
							</div>
						</div>
					))}
				</div>
			</div>

			<!-- Slider Controls -->
			<div class="mt-12 flex items-center justify-center gap-4">
				<!-- Prev Button -->
				<button
					id="carousel-prev"
					type="button"
					aria-label="Testimonio anterior"
					class="inline-flex size-9 cursor-pointer items-center justify-center rounded-full border border-[#824f91]/30 text-[#824f91] hover:border-[#824f91] hover:bg-[#824f91] hover:text-white transition-all shadow-2xs"
				>
					<Icon name="tabler:chevron-left" class="size-5" />
				</button>

				<!-- Dots Indicator Container -->
				<div id="carousel-dots" class="flex items-center gap-2">
					<!-- Generated by client script -->
				</div>

				<!-- Next Button -->
				<button
					id="carousel-next"
					type="button"
					aria-label="Siguiente testimonio"
					class="inline-flex size-9 cursor-pointer items-center justify-center rounded-full border border-[#824f91]/30 text-[#824f91] hover:border-[#824f91] hover:bg-[#824f91] hover:text-white transition-all shadow-2xs"
				>
					<Icon name="tabler:chevron-right" class="size-5" />
				</button>
			</div>
		</div>
	</div>
</section>

<script is:inline>
	(function () {
		const carousel = document.getElementById('testimonials-carousel');
		if (!carousel) return;

		const track = document.getElementById('carousel-track');
		const prevBtn = document.getElementById('carousel-prev');
		const nextBtn = document.getElementById('carousel-next');
		const dotsContainer = document.getElementById('carousel-dots');
		if (!track || !prevBtn || !nextBtn || !dotsContainer) return;

		const totalItems = parseInt(carousel.dataset.count || '0', 10);
		if (totalItems <= 0) return;

		let currentIndex = 0;
		let isDesktop = window.innerWidth >= 768;

		function getVisibleCount() {
			return window.innerWidth >= 768 ? 2 : 1;
		}

		function getMaxIndex() {
			const visible = getVisibleCount();
			return Math.max(0, totalItems - visible);
		}

		function getPagesCount() {
			const visible = getVisibleCount();
			if (visible === 1) return totalItems;
			return Math.ceil(totalItems / 2);
		}

		function renderDots() {
			dotsContainer.innerHTML = '';
			const pages = getPagesCount();
			for (let i = 0; i < pages; i++) {
				const dot = document.createElement('button');
				dot.type = 'button';
				dot.setAttribute('aria-label', `Ir a diapositiva ${i + 1}`);
				dot.className = 'size-2.5 rounded-full transition-all duration-300 cursor-pointer ' +
					(i === getActivePageIndex() ? 'bg-[#824f91] scale-125' : 'bg-neutral-300 hover:bg-neutral-400');
				dot.addEventListener('click', () => {
					goToPage(i);
				});
				dotsContainer.appendChild(dot);
			}
		}

		function getActivePageIndex() {
			const visible = getVisibleCount();
			if (visible === 1) return currentIndex;
			return Math.floor(currentIndex / 2);
		}

		function updateCarousel() {
			const visible = getVisibleCount();
			const percentage = 100 / visible;
			track.style.transform = `translateX(-${currentIndex * percentage}%)`;

			// Update dot states
			const dots = dotsContainer.querySelectorAll('button');
			const activePage = getActivePageIndex();
			dots.forEach((dot, idx) => {
				if (idx === activePage) {
					dot.className = 'size-2.5 rounded-full transition-all duration-300 cursor-pointer bg-[#824f91] scale-125';
				} else {
					dot.className = 'size-2.5 rounded-full transition-all duration-300 cursor-pointer bg-neutral-300 hover:bg-neutral-400';
				}
			});
		}

		function goToPage(pageIndex) {
			const visible = getVisibleCount();
			if (visible === 1) {
				currentIndex = Math.min(pageIndex, getMaxIndex());
			} else {
				currentIndex = Math.min(pageIndex * 2, getMaxIndex());
			}
			updateCarousel();
		}

		prevBtn.addEventListener('click', () => {
			const visible = getVisibleCount();
			if (currentIndex > 0) {
				currentIndex = Math.max(0, currentIndex - (visible === 1 ? 1 : 2));
			} else {
				// Wrap around to end
				currentIndex = getMaxIndex();
			}
			updateCarousel();
		});

		nextBtn.addEventListener('click', () => {
			const maxIndex = getMaxIndex();
			const visible = getVisibleCount();
			if (currentIndex < maxIndex) {
				currentIndex = Math.min(maxIndex, currentIndex + (visible === 1 ? 1 : 2));
			} else {
				// Wrap around to start
				currentIndex = 0;
			}
			updateCarousel();
		});

		// Touch swipe support
		let startX = 0;
		let isTouching = false;

		track.addEventListener('touchstart', (e) => {
			startX = e.touches[0].clientX;
			isTouching = true;
		}, { passive: true });

		track.addEventListener('touchend', (e) => {
			if (!isTouching) return;
			const endX = e.changedTouches[0].clientX;
			const diff = startX - endX;
			if (Math.abs(diff) > 40) {
				if (diff > 0) {
					nextBtn.click();
				} else {
					prevBtn.click();
				}
			}
			isTouching = false;
		}, { passive: true });

		// Handle resize
		let resizeTimeout;
		window.addEventListener('resize', () => {
			clearTimeout(resizeTimeout);
			resizeTimeout = setTimeout(() => {
				const newIsDesktop = window.innerWidth >= 768;
				if (newIsDesktop !== isDesktop) {
					isDesktop = newIsDesktop;
					currentIndex = 0;
					renderDots();
					updateCarousel();
				}
			}, 100);
		});

		// Initial render
		renderDots();
		updateCarousel();
	})();
</script>
