---
import { tinaField } from '@tinacms/astro/tina-field';

interface Props {
	data?: {
		tag?: string | null;
		title?: string | null;
		description?: string | null;
		action?: {
			label?: string | null;
			link?: string | null;
		} | null;
		image?: {
			src?: string | null;
			alt?: string | null;
		} | null;
	} | null;
}

const { data } = Astro.props;
const tag = data?.tag ?? 'QUIÉNES SOMOS';
const title = data?.title ?? 'Un equipo dedicado a tu salud desde hace más de 30 años';
const description = data?.description ?? 'Brindamos a cada paciente un tratamiento personalizado, con un equipo que se capacita día a día. Realizamos rehabilitaciones pre y post-quirúrgicas, abordajes estéticos y tratamientos para adultos mayores, bebés, niños y adolescentes.';
const action = data?.action;
const image = data?.image;
---

<section id="quienes-somos" class="w-full bg-white py-16 px-6 sm:px-8 md:py-24 text-[#222222]">
	<div class="mx-auto max-w-6xl">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
			<!-- Content column -->
			<div class="lg:col-span-6 flex flex-col order-2 lg:order-1">
				<span
					class="text-xs sm:text-sm font-semibold tracking-wider text-[#188a7e] uppercase mb-2"
					data-tina-field={data ? tinaField(data, 'tag') : undefined}
				>
					{tag}
				</span>

				<h2
					class="text-3xl sm:text-4xl font-bold tracking-tight text-[#161616] mb-5 leading-tight"
					data-tina-field={data ? tinaField(data, 'title') : undefined}
				>
					{title}
				</h2>

				<p
					class="text-neutral-600 text-sm sm:text-base leading-relaxed mb-8"
					data-tina-field={data ? tinaField(data, 'description') : undefined}
				>
					{description}
				</p>

				{action?.label && (
					<div>
						<a
							href={action.link || '/about'}
							class="inline-flex items-center justify-center rounded-md border border-[#824f91] bg-white px-6 py-2.5 text-xs sm:text-sm font-medium text-[#824f91] shadow-xs transition-all duration-200 hover:bg-[#824f91] hover:text-white"
							data-tina-field={data?.action ? tinaField(data.action, 'label') : undefined}
						>
							{action.label}
						</a>
					</div>
				)}
			</div>

			<!-- Image column -->
			<div class="lg:col-span-6 order-1 lg:order-2">
				<div class="relative overflow-hidden rounded-3xl shadow-lg bg-neutral-100 aspect-4/3 sm:aspect-5/4 lg:aspect-auto lg:h-[480px]">
					{image?.src && (
						<img
							src={image.src}
							alt={image.alt || title}
							class="h-full w-full object-cover object-center"
							loading="lazy"
							data-tina-field={data?.image ? tinaField(data.image, 'src') : undefined}
						/>
					)}
				</div>
			</div>
		</div>
	</div>
</section>
