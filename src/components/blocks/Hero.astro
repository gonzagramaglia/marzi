---
import { tinaField } from '@tinacms/astro/tina-field';

interface Props {
	data?: {
		image?: {
			src?: string | null;
			alt?: string | null;
		} | null;
		headline?: string | null;
		_template?: string;
	} | null;
}

const { data } = Astro.props;
const imageSrc = data?.image?.src || '/assets/hero.jpg';
const imageAlt = data?.image?.alt || 'Consultorios Marzi Dall’Occhio - Kinesiología, Osteopatía y Fisioterapia';
---

<section id="inicio" class="relative w-full overflow-hidden bg-black scroll-mt-24">
	<div class="relative w-full flex items-center justify-center">
		<img
			src={imageSrc}
			alt={imageAlt}
			class="w-full h-auto max-h-[85vh] object-cover object-center grayscale contrast-105"
			loading="eager"
			data-tina-field={data?.image ? tinaField(data.image, 'src') : undefined}
		/>
	</div>
</section>
