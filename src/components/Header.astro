---
import { Icon } from 'astro-icon/components';
import { tinaField } from "@tinacms/astro/tina-field";
import type { CmsConfig } from '../lib/data';

interface Props {
	config?: CmsConfig | null;
}

const { config } = Astro.props;
const seo = config?.seo ?? null;
const nav = (config?.nav ?? []).filter(item => item !== null);
const contactLinks = (config?.contactLinks ?? []).filter(item => item !== null);
const whatsappLink = seo?.whatsappLink || 'https://wa.me/5493510000000';
const whatsappLabel = seo?.whatsappLabel || 'Contactanos';
const logoSrc = seo?.logo || '/assets/logo-header.png';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
function isItemActive(link: string) {
	const normalized = (link || '').replace(/\/$/, '') || '/';
	if (normalized === '/') {
		return currentPath === '/';
	}
	return currentPath === normalized || currentPath.startsWith(normalized + '/');
}
---

<header class="fixed top-0 z-40 w-full border-b border-neutral-100 bg-white/95 backdrop-blur-md">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-2 sm:py-2.5">
		<nav class="relative flex items-center justify-between min-h-[50px] sm:min-h-[56px] md:min-h-[64px]">
			<!-- Mobile: Menu Toggle Button (Left aligned on mobile) -->
			<div class="flex items-center justify-start lg:hidden z-10">
				<button
					id="mobile-menu-toggle"
					type="button"
					aria-label="Abrir o cerrar menú de navegación"
					aria-controls="mobile-menu-panel"
					aria-expanded="false"
					class="inline-flex size-10 cursor-pointer items-center justify-center rounded-md text-neutral-700 hover:bg-neutral-100 focus-visible:outline-none"
				>
					<Icon name="tabler:menu-2" class="icon-open size-6" />
					<Icon name="tabler:x" class="icon-close size-6" />
				</button>
			</div>

			<!-- Left: Navigation Links (Desktop only) -->
			<div class="hidden lg:flex items-center gap-3.5 xl:gap-6 text-xs xl:text-[13px] whitespace-nowrap z-10">
				{nav.map((item) => {
					const active = isItemActive(item.link);
					return (
						<a
							href={item.link}
							class:list={[
								"header-nav-link transition-colors py-1",
								active
									? "text-[#824f91] font-semibold"
									: "text-neutral-800 font-medium hover:text-[#824f91]"
							]}
							data-nav-href={item.link}
							data-tina-field={tinaField(item, "title")}
						>
							{item.title}
						</a>
					);
				})}
			</div>

			<!-- Center: Logo (Centered on both mobile & desktop) -->
			<div class="absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 flex items-center justify-center pointer-events-auto">
				<a href="/" class="flex items-center py-0.5 translate-y-1 sm:translate-y-0" aria-label={seo?.title || "Marzi Dall'Occhio Consultorio"}>
					<img
						src={logoSrc}
						alt={seo?.title || "Marzi Dall'Occhio Consultorio"}
						class="h-14 sm:h-15 md:h-16 lg:h-17 w-auto object-contain transition-all"
						data-tina-field={seo ? tinaField(seo, "logo") : undefined}
					/>
				</a>
			</div>

			<!-- Right: Social Links + WhatsApp CTA (Desktop) & WhatsApp icon (Mobile) -->
			<div class="hidden lg:flex items-center gap-3.5 xl:gap-4 shrink-0 z-10">
				<!-- Social Icons -->
				<div class="flex items-center gap-2 text-neutral-700">
					{contactLinks.map((link) => (
						<a
							href={link.link}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={link.title || 'Red social'}
							class="flex size-8 items-center justify-center rounded-full text-neutral-700 hover:text-[#824f91] hover:bg-neutral-100 transition-colors"
							data-tina-field={tinaField(link, "title")}
						>
							{link.icon ? <Icon name={link.icon} class="size-4" /> : <span>{link.title}</span>}
						</a>
					))}
				</div>

				<!-- WhatsApp CTA Button -->
				<a
					href={whatsappLink}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 rounded-full border border-[#58b8ab] bg-[#eef8f6] px-4 py-1.5 text-xs font-semibold text-[#188a7e] shadow-2xs transition-all duration-200 hover:bg-[#188a7e] hover:text-white"
					data-tina-field={seo ? tinaField(seo, "whatsappLabel") : undefined}
				>
					<Icon name="tabler:brand-whatsapp" class="size-4 shrink-0" />
					<span>{whatsappLabel}</span>
				</a>
			</div>

			<!-- Mobile Right: WhatsApp direct icon button for balance -->
			<div class="flex items-center justify-end lg:hidden z-10">
				<a
					href={whatsappLink}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={whatsappLabel}
					class="inline-flex size-10 items-center justify-center rounded-full text-[#188a7e] hover:bg-[#eef8f6] transition-colors"
				>
					<Icon name="tabler:brand-whatsapp" class="size-5.5" />
				</a>
			</div>
		</nav>
	</div>

	<!-- Mobile Drawer Menu -->
	<div
		id="mobile-menu-panel"
		hidden
		class="border-t border-neutral-100 bg-white shadow-xl lg:hidden"
	>
		<div class="flex flex-col px-6 py-5 space-y-3">
			{nav.map((item) => {
				const active = isItemActive(item.link);
				return (
					<a
						href={item.link}
						class:list={[
							"header-nav-link py-2 text-sm transition-colors",
							active
								? "text-[#824f91] font-semibold bg-[#824f91]/5 rounded-lg px-3"
								: "text-neutral-800 font-medium hover:text-[#824f91]"
						]}
						data-nav-href={item.link}
						data-tina-field={tinaField(item, "title")}
					>
						{item.title}
					</a>
				);
			})}

			{contactLinks.length > 0 && (
				<div class="pt-4 border-t border-neutral-100 flex items-center gap-3">
					{contactLinks.map((link) => (
						<a
							href={link.link}
							target="_blank"
							rel="noopener noreferrer"
							class="flex size-9 items-center justify-center rounded-full bg-neutral-100 text-neutral-700 hover:text-[#824f91] transition-colors"
							data-tina-field={tinaField(link, "title")}
						>
							{link.icon && <Icon name={link.icon} class="size-4" />}
						</a>
					))}
				</div>
			)}
		</div>
	</div>
</header>

<style>
	#mobile-menu-toggle .icon-close { display: none; }
	#mobile-menu-toggle[aria-expanded="true"] .icon-open { display: none; }
	#mobile-menu-toggle[aria-expanded="true"] .icon-close { display: block; }
</style>

<script is:inline>
	if (!window.__mobileMenuBound) {
		window.__mobileMenuBound = true;
		const setOpen = (open) => {
			const btn = document.getElementById('mobile-menu-toggle');
			const panel = document.getElementById('mobile-menu-panel');
			if (!btn || !panel) return;
			btn.setAttribute('aria-expanded', open ? 'true' : 'false');
			panel.hidden = !open;
		};
		document.addEventListener('click', (e) => {
			const toggle = e.target.closest('#mobile-menu-toggle');
			if (toggle) {
				const isOpen = toggle.getAttribute('aria-expanded') === 'true';
				setOpen(!isOpen);
				return;
			}
			if (e.target.closest('#mobile-menu-panel a')) {
				setOpen(false);
			}
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') setOpen(false);
		});

		const syncActiveNav = () => {
			const current = window.location.pathname.replace(/\/$/, '') || '/';
			document.querySelectorAll('a[data-nav-href]').forEach((el) => {
				const target = (el.getAttribute('data-nav-href') || '').replace(/\/$/, '') || '/';
				const active = target === '/' ? current === '/' : (current === target || current.startsWith(target + '/'));
				const isMobile = Boolean(el.closest('#mobile-menu-panel'));

				if (isMobile) {
					if (active) {
						el.classList.add('text-[#824f91]', 'font-semibold', 'bg-[#824f91]/5', 'rounded-lg', 'px-3');
						el.classList.remove('text-neutral-800', 'font-medium');
					} else {
						el.classList.remove('text-[#824f91]', 'font-semibold', 'bg-[#824f91]/5', 'rounded-lg', 'px-3');
						el.classList.add('text-neutral-800', 'font-medium');
					}
				} else {
					if (active) {
						el.classList.add('text-[#824f91]', 'font-semibold');
						el.classList.remove('text-neutral-800', 'font-medium');
					} else {
						el.classList.remove('text-[#824f91]', 'font-semibold');
						el.classList.add('text-neutral-800', 'font-medium');
					}
				}
			});
		};

		document.addEventListener('astro:page-load', syncActiveNav);
	}
</script>
