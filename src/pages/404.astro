---
import Base from '../layouts/Base.astro';
import Starfield from '../components/space/Starfield.astro';
import Button from '../components/ui/Button.astro';
---
<Base title="Página no encontrada (404)" description="Esta página salió de órbita o no existe.">
	<section class="relative flex min-h-[70vh] items-center justify-center overflow-hidden px-6 text-center">
		<Starfield count={90} class="text-foreground/20" />
		<div class="relative flex flex-col items-center">
			<img src="/llamanaut.png" alt="Astronauta" aria-hidden="true" width="160" height="160" class="mb-6 size-40 object-contain" />
			<p class="text-sm font-medium tracking-widest text-[#824f91] uppercase">Error 404</p>
			<h1 class="mt-2 text-4xl font-semibold tracking-tight text-neutral-900 lg:text-5xl">Perdidos en el espacio</h1>
			<p class="mx-auto mt-4 max-w-md text-neutral-600">Esta página salió de órbita o no existe. Volvamos al inicio.</p>
			<Button href="/" class="mt-8 bg-[#824f91] hover:bg-[#6e3f7d] text-white">Volver al inicio</Button>
		</div>
	</section>
</Base>
