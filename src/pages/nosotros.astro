---
import Base from '../layouts/Base.astro';
import { getConfig } from '../lib/data';

const config = (await getConfig()).data?.config ?? null;
const whatsappLink = config?.seo?.whatsappLink || 'https://wa.me/5493510000000';

const team = [
	{
		name: 'Juan J. Marzi',
		role: 'Lic. en Kinesiología y Fisioterapia, Diplomado en Osteopatía (M.P. 2403)',
		image: '/assets/man.jpg',
		bio: 'Más de 30 años de trayectoria acompañando a sus pacientes en osteopatía, kinesiología y fisioterapia, con un enfoque personalizado en cada tratamiento.',
	},
	{
		name: 'Tiziana Marzi',
		role: 'Lic. en Kinesiología y Fisioterapia',
		image: '/assets/woman.jpg',
		bio: 'Profesional del equipo que colabora en los tratamientos de kinesiología, fisioterapia y drenaje linfático, con capacitación continua en nuevas técnicas.',
	},
];
---

<Base
	title={`Quiénes Somos | ${config?.seo?.title ?? "Marzi Dall'Occhio Consultorio"}`}
	description="Conocé nuestro equipo de profesionales y los tratamientos que ofrecemos con más de 30 años dedicados a tu salud en Córdoba."
>
	<!-- Hero Banner (Purple) -->
	<section class="w-full bg-[#824f91] py-16 sm:py-20 md:py-24 px-6 text-center text-white">
		<div class="mx-auto max-w-3xl">
			<h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight mb-4 text-white">
				Quiénes Somos
			</h1>
			<p class="text-white/90 text-sm sm:text-base md:text-lg max-w-xl mx-auto font-normal leading-relaxed text-balance">
				Conocé nuestro equipo y los tratamientos que ofrecemos
			</p>
		</div>
	</section>

	<!-- Intro Section & Team Cards (White Background) -->
	<section class="w-full bg-white py-14 sm:py-18 md:py-20 px-6 sm:px-8">
		<div class="mx-auto max-w-5xl">
			<!-- Intro Title & Description (Replica from design) -->
			<div class="text-center max-w-3xl mx-auto mb-14 sm:mb-16 md:mb-20">
				<h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-[#161616] mb-4 text-balance">
					Un equipo dedicado a tu salud desde hace más de 30 años
				</h2>
				<p class="text-neutral-600 text-sm sm:text-base md:text-lg leading-relaxed text-balance">
					Brindamos a cada paciente un tratamiento personalizado. Realizamos rehabilitaciones pre y post-quirúrgicas, abordajes estéticos y tratamientos para adultos mayores, bebés, niños y adolescentes.
				</p>
			</div>

			<!-- Team Cards Grid (Without CTA buttons) -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
				{team.map((member) => (
					<div class="flex flex-col bg-neutral-50/70 rounded-3xl p-6 sm:p-8 border border-neutral-100 transition-all hover:shadow-md">
						<div class="overflow-hidden rounded-2xl bg-neutral-200 aspect-16/10 sm:aspect-16/9 mb-6 shadow-xs">
							<img
								src={member.image}
								alt={member.name}
								class="h-full w-full object-cover object-top"
								loading="lazy"
							/>
						</div>
						
						<h3 class="text-xl sm:text-2xl font-bold text-[#161616] mb-1">
							{member.name}
						</h3>
						
						<span class="text-xs sm:text-sm font-semibold text-[#188a7e] mb-4 block">
							{member.role}
						</span>
						
						<p class="text-sm sm:text-base text-neutral-600 leading-relaxed">
							{member.bio}
						</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- CTA Banner: Agendar turno (Consulta banner above footer) -->
	<section class="relative w-full overflow-hidden py-20 sm:py-24 px-6 text-white text-center">
		<div class="absolute inset-0 z-0">
			<img
				src="/assets/consultas-banner.jpg"
				alt="Consultas Consultorios Marzi"
				class="h-full w-full object-cover object-center"
				loading="lazy"
			/>
			<div class="absolute inset-0 bg-[#7c4d8c]/85 mix-blend-multiply"></div>
			<div class="absolute inset-0 bg-gradient-to-t from-[#693977]/90 via-[#824f91]/80 to-[#693977]/90"></div>
		</div>

		<div class="relative z-10 mx-auto max-w-2xl">
			<h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-wider text-white mb-4 uppercase">
				Agendá tu turno
			</h2>
			<p class="text-white/90 text-sm sm:text-base leading-relaxed mb-8 max-w-lg mx-auto">
				Escribinos por WhatsApp asi coordinamos tu<br />
				primera cita de manera personalizada.
			</p>
			<div class="flex justify-center">
				<a
					href={whatsappLink}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center justify-center rounded-md bg-white px-6 py-2.5 text-xs sm:text-sm font-medium text-neutral-900 shadow-xs transition-all duration-200 hover:bg-neutral-100"
				>
					Hablemos ahora
				</a>
			</div>
		</div>
	</section>
</Base>
